# ============================================================
# MIMOSA FLOUR — Configuration de PRODUCTION (mimosaflour.com)
# ============================================================
# Copier ce fichier vers ".env" sur le serveur de production puis
# renseigner toutes les valeurs marquées CHANGEME.
# Ne JAMAIS committer le fichier ".env" réel dans Git.
# ------------------------------------------------------------

APP_NAME="Mimosa Flour"
APP_ENV=production
APP_KEY=base64:w7SoIRFufhgA04V/oBNs7kdK81SCJdMVIdFinYZ0574=                # Générer avec : php artisan key:generate
APP_DEBUG=false
APP_URL=https://mimosaflour.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR


APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------
# Base de données (MySQL — requis : migrations utilisant ALTER ENUM)
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mimosa_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# Session / Cache / Files / Queue
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mimosaflour.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ------------------------------------------------------------
# Mail (à adapter au fournisseur SMTP retenu : OVH, SendGrid, etc.)
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=CHANGEME_smtp_host
MAIL_PORT=587
MAIL_USERNAME=CHANGEME_smtp_user
MAIL_PASSWORD=CHANGEME_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@mimosaflour.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
